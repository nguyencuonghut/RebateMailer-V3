# ─────────────────────────────────────────────────────────────────────────────
# .env.production — Production environment variables for RebateMailer-V3
# Copy file này thành .env.production và điền giá trị thực tế
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=RebateMailerV3
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_output
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Host phải trùng với service name trong docker-compose.yml
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rebate_mailer_v3
DB_USERNAME=rebate_mailer
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Queue ────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_STORE=redis
REDIS_CACHE_CONNECTION=cache

# ─── Redis ────────────────────────────────────────────────────────────────────
# Host phải trùng với service name trong docker-compose.yml
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_USERNAME=null
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ─── Mail (SMTP) ─────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.honghafeed.com.vn
MAIL_PORT=587
MAIL_USERNAME=no-reply@honghafeed.com.vn
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=no-reply@honghafeed.com.vn
MAIL_FROM_NAME="Chiết khấu Honghafeed"

# ─── Mail Campaign Dispatch ───────────────────────────────────────────────────
MAIL_CAMPAIGN_DISPATCH_QUEUE=default
MAIL_CAMPAIGN_MAX_PER_MINUTE=20
MAIL_CAMPAIGN_TRIES=50
MAIL_CAMPAIGN_MAX_EXCEPTIONS=10
MAIL_CAMPAIGN_RETRY_UNTIL_HOURS=6
MAIL_CAMPAIGN_BACKOFF_JITTER_SECONDS=30
MAIL_CAMPAIGN_RECIPIENT_LOCK_SECONDS=120
MAIL_CAMPAIGN_RELEASE_AFTER_SECONDS=15

# ─── AWS (nếu dùng S3 storage) ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
