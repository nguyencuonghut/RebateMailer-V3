APP_NAME=RebateMailerV3
# Set to 'production' on the production server
APP_ENV=local
APP_KEY=
# Set to false in production
APP_DEBUG=true
# Set to your actual domain in production, e.g. https://rebatemailer.honghafeed.com.vn
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use 'warning' or 'error' in production
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rebate_mailer_v3
DB_USERNAME=rebate_mailer
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
# Set to true in production
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

CACHE_STORE=redis
REDIS_CACHE_CONNECTION=cache
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
# Set a strong password in production
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Chiết khấu Honghafeed"
MAILPIT_WEB_UI_URL=http://127.0.0.1:8025
MAILPIT_PROBE_RECIPIENT=dev@rebatemailer.test

# Mail campaign dispatch settings
# Queue name for dispatch jobs — run: php artisan queue:work --queue=$MAIL_CAMPAIGN_DISPATCH_QUEUE
MAIL_CAMPAIGN_DISPATCH_QUEUE=default
MAIL_CAMPAIGN_MAX_PER_MINUTE=50
MAIL_CAMPAIGN_TRIES=5
MAIL_CAMPAIGN_RECIPIENT_LOCK_SECONDS=120
MAIL_CAMPAIGN_RELEASE_AFTER_SECONDS=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
